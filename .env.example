# ==============================================================================
# LinkHub v2.0.0 — Environment Configuration Template (NO REAL SECRETS HERE)
# ==============================================================================

# --- Server-Side Secrets (Express / Netlify Functions ONLY — NEVER prefix VITE_) ---
# Gemini API key used strictly on the backend (/api/ai/link-metadata)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server HTTP port (must remain 3000 in local dev / AI Studio preview)
PORT=3000

# Comma-separated CORS origin allowlist in addition to defaults
# Example: https://linkhub-v1.netlify.app,https://app.example.com
ALLOWED_ORIGINS=""

# Optional Firebase Admin credentials (recommended for Netlify Functions / persisted shares)
FIREBASE_PROJECT_ID="gen-lang-client-0297873222"
FIRESTORE_DATABASE_ID=""
# Inline JSON string of Firebase Admin SDK service account credentials (set in host secrets panel)
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Enforce Firebase App Check verification on protected backend endpoints ("true" | "false")
APPCHECK_ENFORCE="false"

# Optional external reference URL
APP_URL="http://localhost:3000"

# --- Client-Side Public Configuration (Safe to expose via Vite bundle) ---
# Firebase App Check site key (reCAPTCHA Enterprise or reCAPTCHA v3)
VITE_FIREBASE_APPCHECK_SITE_KEY=""
# Set to "v3" for ReCaptchaV3Provider; defaults to ReCaptchaEnterpriseProvider
VITE_APPCHECK_PROVIDER="enterprise"
# Local dev only: "true" to auto-generate a debug token or paste a registered debug token UUID
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=""

# Keep disabled in production ("false"); enabled only in isolated E2E test builds
VITE_ENABLE_E2E_HOOK="false"
