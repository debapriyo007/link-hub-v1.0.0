{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and hardened v2 vault security configuration.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Immutable Firebase Auth UID of the owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified email address of the user.",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the user.",
          "minLength": 1,
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "description": "Profile avatar URL or compact compressed data URL.",
          "minLength": 0,
          "maxLength": 32768
        },
        "pin": {
          "type": "string",
          "description": "Legacy v1 field kept empty in v2; replaced by pinVerifier.",
          "minLength": 0,
          "maxLength": 6,
          "pattern": "^([0-9]{6})?$"
        },
        "pinVerifier": {
          "type": "string",
          "description": "PBKDF2-SHA256 salted verifier envelope for vault lock PIN (never plaintext).",
          "minLength": 0,
          "maxLength": 256
        },
        "vaultVersion": {
          "type": "number",
          "description": "Schema/cryptography version (1 = legacy, 2 = AES-256-GCM)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the user profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the user profile was last updated."
        }
      },
      "required": ["uid", "email", "displayName", "photoURL", "pin", "createdAt", "updatedAt"]
    },
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "Owner-only synced client preferences and hashed PIN recovery challenge.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "firstName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 60
        },
        "lastName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 60
        },
        "countryCode": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "autoLockMinutes": {
          "type": "number"
        },
        "soundEnabled": {
          "type": "boolean"
        },
        "securityQuestion": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "securityAnswerHash": {
          "type": "string",
          "description": "PBKDF2-SHA256 salted verifier for PIN recovery answer.",
          "minLength": 0,
          "maxLength": 256
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "createdAt", "updatedAt"]
    },
    "Entitlement": {
      "title": "Entitlement",
      "description": "Server-managed subscription and billing entitlement record (client read-only).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "plan": {
          "type": "string",
          "enum": ["free", "pro", "team"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "canceled", "past_due", "expired"]
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "plan", "status", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "User-defined or default bookmark category stored inside the user's vault.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Category document identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "UID of the user who owns this category.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Display name or encrypted category label.",
          "minLength": 1,
          "maxLength": 240
        },
        "slug": {
          "type": "string",
          "description": "URL-friendly category slug.",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "color": {
          "type": "string",
          "description": "Hex color code for the category badge.",
          "minLength": 4,
          "maxLength": 20
        },
        "icon": {
          "type": "string",
          "description": "Icon identifier name.",
          "minLength": 1,
          "maxLength": 40
        },
        "description": {
          "type": "string",
          "description": "Category description or private vault encrypted envelope.",
          "minLength": 0,
          "maxLength": 1024
        },
        "isDefault": {
          "type": "boolean",
          "description": "Whether this is a starter category."
        },
        "isPrivate": {
          "type": "boolean",
          "description": "Whether bookmarks in this category are client-side encrypted."
        },
        "privateVaultMeta": {
          "type": "string",
          "description": "v2 PBKDF2 + AES-GCM wrapped DEK metadata for private categories.",
          "minLength": 0,
          "maxLength": 1024
        },
        "order": {
          "type": "number",
          "description": "Display sort order index."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the category was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the category was last updated."
        }
      },
      "required": [
        "id",
        "userId",
        "name",
        "slug",
        "color",
        "icon",
        "description",
        "isDefault",
        "order",
        "createdAt",
        "updatedAt"
      ]
    },
    "LinkItem": {
      "title": "LinkItem",
      "description": "Bookmark item stored in the user's private cloud vault.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Bookmark document identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "UID of the user who owns this bookmark.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Bookmark title or ENC2 AES-256-GCM ciphertext.",
          "minLength": 1,
          "maxLength": 512
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Destination URL or encrypted vault URL payload.",
          "minLength": 4,
          "maxLength": 4096
        },
        "categorySlug": {
          "type": "string",
          "description": "Slug of the category this bookmark belongs to.",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "description": {
          "type": "string",
          "description": "Notes, summary, or ENC2 ciphertext.",
          "minLength": 0,
          "maxLength": 2048
        },
        "tags": {
          "type": "array",
          "description": "Bounded list of up to 10 string tags."
        },
        "isFavorite": {
          "type": "boolean",
          "description": "Whether the bookmark is starred."
        },
        "clickCount": {
          "type": "number",
          "description": "Number of times the user has opened this bookmark."
        },
        "imageUrl": {
          "type": "string",
          "description": "Optional preview image URL.",
          "minLength": 0,
          "maxLength": 2048
        },
        "faviconUrl": {
          "type": "string",
          "description": "Favicon URL for the bookmark domain.",
          "minLength": 0,
          "maxLength": 2048
        },
        "isEncrypted": {
          "type": "boolean",
          "description": "Whether sensitive link fields are encrypted."
        },
        "cryptoVersion": {
          "type": "number",
          "description": "1 = legacy ENC1, 2 = AES-256-GCM ENC2."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the bookmark was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the bookmark was last updated."
        }
      },
      "required": [
        "id",
        "userId",
        "title",
        "url",
        "categorySlug",
        "description",
        "tags",
        "isFavorite",
        "clickCount",
        "imageUrl",
        "faviconUrl",
        "createdAt",
        "updatedAt"
      ]
    },
    "ShareRecord": {
      "title": "ShareRecord",
      "description": "High-entropy revocable, expiring read-only category share bundle.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "High-entropy share token identifier (>= 22 URL-safe chars).",
          "minLength": 22,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "categoryName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "categorySlug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "categoryIcon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "categoryColor": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20
        },
        "readOnly": {
          "type": "boolean"
        },
        "hasPassword": {
          "type": "boolean"
        },
        "revoked": {
          "type": "boolean"
        },
        "linkCount": {
          "type": "number"
        },
        "links": {
          "type": "array",
          "description": "Bounded snapshot of up to 40 shared public bookmarks."
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "categoryName",
        "categorySlug",
        "readOnly",
        "hasPassword",
        "revoked",
        "links",
        "expiresAt",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private user profile and vault security configuration document."
    },
    "/users/{userId}/preferences/{prefId}": {
      "schema": {
        "$ref": "#/entities/UserPreferences"
      },
      "description": "Owner-only preferences and hashed recovery challenge."
    },
    "/users/{userId}/entitlements/{entitlementId}": {
      "schema": {
        "$ref": "#/entities/Entitlement"
      },
      "description": "Server-managed subscription and entitlement records (client read-only)."
    },
    "/users/{userId}/categories/{categoryId}": {
      "schema": {
        "$ref": "#/entities/Category"
      },
      "description": "User's private bookmark categories subcollection."
    },
    "/users/{userId}/links/{linkId}": {
      "schema": {
        "$ref": "#/entities/LinkItem"
      },
      "description": "User's private bookmarks subcollection."
    },
    "/shares/{shareId}": {
      "schema": {
        "$ref": "#/entities/ShareRecord"
      },
      "description": "High-entropy revocable, expiring read-only category share records."
    }
  }
}
